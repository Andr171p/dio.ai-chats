# Copy to .env in the repository root. Docker Compose reads this file.
# Public HTTP endpoint. Use 127.0.0.1 behind a host reverse proxy with HTTPS.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Persistent databases; their ports are not published to the host.
MONGO_IMAGE=mongo:8
MONGO_USERNAME=root
# Generate with: openssl rand -hex 32
MONGO_PASSWORD=
MONGO_DB=ai_chats
REDIS_IMAGE=redis:8-alpine
# Generate a DIFFERENT password: openssl rand -hex 32
REDIS_PASSWORD=

# Existing DIO desk IAM, reachable from containers. Origin only, no trailing /.
# For IAM on the Docker host: http://host.docker.internal:8001
# localhost / 127.0.0.1 here would point to each container itself.
IAM_BASE_URL=https://iam.example.com
# Use the existing organization UUID when migrating data.
IAM_DEFAULT_ORGANIZATION_ID=
IAM_IDENTITY_CACHE_TTL=60

# Generate ONCE: openssl rand -base64 32
# Keep the existing key when migrating MongoDB; back it up separately.
SECRETS_MASTER_KEY=

# Public frontend build setting; never put secrets in VITE_* values.
# API paths are fixed to /auth-api and /chats-api in the frontend Dockerfile.
VITE_TRUSTED_ORIGINS=
